# 이 파일을 .env로 복사한 뒤 각 컴퓨터에서 값을 채웁니다.
# .env는 커밋하지 않습니다 (.gitignore에 포함). IP, 경로, 토큰은 .env에만 둡니다.

# AI 컴퓨터(Ubuntu)의 LAN IP. 메인 컴퓨터가 UDP 수신/SSH 접속에 사용합니다.
AIBOX_LAN_IP=192.168.x.x

# Samba 공유 폴더 경로 (각 컴퓨터 기준)
#   AI 컴퓨터 예:   /srv/roomar
#   메인 컴퓨터 예: \\192.168.x.x\roomar  또는 Z:\
SHARED_DIR=

# 관절 데이터 UDP 포트 (AI 컴퓨터 → 메인 컴퓨터)
UDP_PORT=9000

# Unity 에디터 실행 파일 경로 (메인 컴퓨터 전용)
#   예: C:\Program Files\Unity\Hub\Editor\6000.3.28f1\Editor\Unity.exe
UNITY_EXE=

# VGGT 가중치 경로 (AI 컴퓨터 전용)
VGGT_WEIGHTS=
